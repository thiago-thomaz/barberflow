// BarberFlow - Prisma Schema (Production Hardened SaaS Architecture)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Core Multi-tenancy & User Management
// ----------------------------------------------------

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("OWNER") // SUPER_ADMIN, OWNER, BARBER, RECEPTIONIST
  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs          AuditLog[]
  adminAuditLogs     AdminAuditLog[]
  passwordResetTokens PasswordResetToken[]
  educationProgress   EducationProgress[]
  educationFavorites  EducationFavorite[]
  educationAiConsultations EducationAiConsultation[]
  academyDiagnostics  AcademyDiagnostic[]
  academyActionPlans  AcademyActionPlan[]

  @@index([barbershopId])
  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Barbershop {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  phone          String?
  address        String?
  city           String?
  state          String?
  logoUrl        String?
  settings       String?              // JSON encoded custom settings & WhatsApp templates
  isActive       Boolean              @default(true)
  
  // WhatsApp & Reminders Engine Settings
  whatsappActive Boolean              @default(true)
  reminder24h    Boolean              @default(true)
  reminder6h     Boolean              @default(true)
  reminder2h     Boolean              @default(true)
  reminder1h     Boolean              @default(true)
  whatsappApiKey String?
  whatsappPhoneId String?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  users          User[]
  barbers        Barber[]
  customers      Customer[]
  services       Service[]
  appointments   Appointment[]
  payments       Payment[]
  businessHours  BusinessHours[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  adminAuditLogs AdminAuditLog[]
  subscriptions  Subscription[]
  saasPayments   SaaSPayment[]
  events         AutomationEvent[]
  notifications  Notification[]
  subscriptionEvents SubscriptionEvent[]
  whatsappSessions   WhatsappSession[]
  whatsappMessages   WhatsappMessage[]
  appointmentReminders AppointmentReminder[]
  financialAccounts    FinancialAccount[]
  financialCategories  FinancialCategory[]
  suppliers            Supplier[]
  financialTransactions FinancialTransaction[]
  cashRegisters        CashRegister[]
  financialRecurringRules FinancialRecurringRule[]
  moneyOnTheTableRecoveries MoneyOnTheTableRecovery[]
  educationProgress         EducationProgress[]
  educationFavorites        EducationFavorite[]
  educationAiConsultations  EducationAiConsultation[]
  academyDiagnostics        AcademyDiagnostic[]
  academyActionPlans        AcademyActionPlan[]
  academyDiagnosticSnapshots AcademyDiagnosticSnapshot[]
  visagismSessions          VisagismSession[]
  visagismMetrics           VisagismMetric[]

  @@index([slug])
  @@index([isActive])
}

// ----------------------------------------------------
// Operational Entities (Barbers, Services, Hours)
// ----------------------------------------------------

model Barber {
  id           String        @id @default(cuid())
  barbershopId String
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  specialty    String?
  commission   Float?        @default(0.0) // Percentage (e.g. 50 = 50%)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]
  payments     Payment[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model Service {
  id           String        @id @default(cuid())
  barbershopId String
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMin  Int           @default(30)
  price        Float
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]

  @@index([barbershopId])
  @@index([barbershopId, isActive])
}

model BusinessHours {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime     String     // "09:00"
  closeTime    String     // "19:00"
  isOpen       Boolean    @default(true)

  @@unique([barbershopId, dayOfWeek])
  @@index([barbershopId])
}

// ----------------------------------------------------
// Customers, LGPD & Recurrence Engine
// ----------------------------------------------------

model Customer {
  id               String              @id @default(cuid())
  barbershopId     String
  barbershop       Barbershop          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  whatsappPhone    String?
  email            String?
  birthDate        DateTime?
  notes            String?             // Preferences, style notes
  status           String              @default("NOVO") // NOVO, ATIVO, EM_RISCO, INATIVO, VIP
  recurrenceRate   String              @default("MEDIA") // ALTA, MEDIA, BAIXA
  noShowCount      Int                 @default(0)
  marketingOptIn   Boolean             @default(true)  // LGPD consent
  privacyConsentAt DateTime?                           // LGPD consent timestamp
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  stats            CustomerVisitStats?
  appointments     Appointment[]
  payments         Payment[]
  notifications    Notification[]
  whatsappMessages WhatsappMessage[]
  financialTransactions FinancialTransaction[]
  moneyOnTheTableRecoveries MoneyOnTheTableRecovery[]
  visagismSessions          VisagismSession[]

  @@index([barbershopId])
  @@index([phone])
  @@index([whatsappPhone])
  @@index([status])
  @@index([barbershopId, phone])
}

model CustomerVisitStats {
  id                   String    @id @default(cuid())
  customerId           String    @unique
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalVisits          Int       @default(0)
  totalSpent           Float     @default(0.0)
  avgTicket            Float     @default(0.0)
  avgDaysBetweenVisits Float     @default(0.0)
  medianDaysBetween    Float     @default(0.0)
  lastVisitDate        DateTime?
  estimatedNextVisit   DateTime?
  daysSinceLastVisit   Int       @default(0)
  updatedAt            DateTime  @updatedAt

  @@index([customerId])
  @@index([estimatedNextVisit])
}

// ----------------------------------------------------
// Appointments & Payments
// ----------------------------------------------------

model Appointment {
  id           String      @id @default(cuid())
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  barberId     String
  barber       Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  scheduledAt          DateTime
  endAt                DateTime
  durationMinutes      Int         @default(30)
  status               String      @default("AGENDADO") // AGENDADO, CONFIRMADO, EM_ATENDIMENTO, CONCLUIDO, CANCELADO, NO_SHOW
  origin               String      @default("WEB") // WEB, WHATSAPP, ADMIN, MANUAL
  cancelReason         String?
  cancelledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  publicToken          String      @unique @default(cuid())
  idempotencyKey       String?     @unique
  notes                String?
  price                Float
  serviceNameSnapshot  String?
  servicePriceSnapshot Float?
  rescheduledFromId    String?
  rescheduledToId      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  payment              Payment?
  reminders            AppointmentReminder[]
  financialTransactions FinancialTransaction[]
  moneyRecovery        MoneyOnTheTableRecovery?

  @@index([barbershopId])
  @@index([barberId])
  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([origin])
  @@index([publicToken])
  @@index([barbershopId, barberId, scheduledAt])
  @@index([barbershopId, scheduledAt])
}

model Payment {
  id            String       @id @default(cuid())
  barbershopId  String
  barbershop    Barbershop   @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  barberId      String?
  barber        Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  
  amount        Float
  method        String       @default("PIX") // PIX, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, OUTRO
  status        String       @default("PAGO") // PENDENTE, PAGO, CANCELADO
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([barbershopId])
  @@index([status])
  @@index([createdAt])
  @@index([barbershopId, createdAt])
}

// ----------------------------------------------------
// Subscriptions, Plans & Monetization
// ----------------------------------------------------

model Plan {
  id                     String         @id @default(cuid())
  name                   String         // STARTER, PRO, BUSINESS
  tier                   String         @unique @default("PRO") // STARTER, PRO, BUSINESS
  price                  Float
  interval               String         @default("MONTHLY") // MONTHLY, YEARLY
  maxBarbers             Int            @default(2)
  maxMonthlyAppointments Int            @default(200)
  hasWhatsappAutomation  Boolean        @default(false)
  hasAdvancedAnalytics   Boolean        @default(false)
  hasMultiUnit           Boolean        @default(false)
  featuresJson           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String     @id @default(cuid())
  barbershopId         String     @unique
  barbershop           Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  status               String     @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime   @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  externalCustomerId   String?
  externalSubscriptionId String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  saasPayments         SaaSPayment[]

  @@index([barbershopId])
  @@index([status])
}

model SubscriptionEvent {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  eventType    String     // invoice.paid, subscription.created, trial.expired
  payload      String     // JSON payload
  createdAt    DateTime   @default(now())

  @@index([barbershopId])
}

// ----------------------------------------------------
// Notifications & Webhook Event Bus
// ----------------------------------------------------

model Notification {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel      String     // WHATSAPP, EMAIL, SMS
  type         String     // APPOINTMENT_REMINDER, RETURN_RECURRENCE, INACTIVE_RECOVERY
  status       String     // PENDING, SENT, DELIVERED, FAILED
  provider     String?    // N8N_WEBHOOK, Z_API, EVOLUTION, RESEND
  externalId   String?
  error        String?
  metadata     String?    // JSON
  sentAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([barbershopId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Webhook {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  url          String
  secret       String     // HMAC secret for payload signature
  isActive     Boolean    @default(true)
  events       String     // JSON array of event names or "*"
  lastTriggerAt DateTime?
  lastStatus   Int?       // e.g. 200, 500
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId])
}

model AutomationEvent {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  event        String     // APPOINTMENT_CREATED, CUSTOMER_AT_RISK, etc.
  payload      String     // JSON payload
  delivered    Boolean    @default(false)
  attempts     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([barbershopId])
  @@index([event])
}

// ----------------------------------------------------
// Security, Rate Limiting & Audit Logging
// ----------------------------------------------------

model AuditLog {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Barbershop  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String      // CREATE, UPDATE, DELETE, LOGIN, CANCEL, COMPLETE
  entity       String      // Customer, Appointment, Barber, etc.
  entityId     String?
  requestId    String?
  metadata     String?     // JSON metadata
  createdAt    DateTime    @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@index([requestId])
}

// ----------------------------------------------------
// WhatsApp Conversational Engine, Sessions & Reminders
// ----------------------------------------------------

model WhatsappSession {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  phone        String     // E.164 canonical normalized phone number (e.g. 5514998016163)
  state        String     @default("IDLE") // IDLE, SELECTING_SERVICE, SELECTING_BARBER, SELECTING_DATE, SELECTING_TIME, WAITING_CONFIRMATION, BOOKED, CANCELLING, RESCHEDULING, OPTED_OUT
  context      String?    // JSON context holding serviceId, barberId, date, time, customerName, etc.
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([barbershopId, phone])
  @@index([phone])
  @@index([expiresAt])
}

model WhatsappMessage {
  id                String     @id @default(cuid())
  barbershopId      String
  barbershop        Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone             String
  direction         String     // INBOUND, OUTBOUND
  type              String     @default("TEXT") // TEXT, INTERACTIVE, TEMPLATE, DOCUMENT
  template          String?
  content           String?
  status            String     @default("SENT") // QUEUED, SENT, DELIVERED, READ, FAILED
  providerMessageId String?
  appointmentId     String?
  createdAt         DateTime   @default(now())

  @@index([barbershopId, phone])
  @@index([providerMessageId])
  @@index([appointmentId])
}

model AppointmentReminder {
  id                String      @id @default(cuid())
  barbershopId      String
  barbershop        Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reminderType      String      // T_24H, T_6H, T_2H, T_1H
  scheduledFor      DateTime
  status            String      @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  sentAt            DateTime?
  providerMessageId String?
  attempts          Int         @default(0)
  error             String?
  idempotencyKey    String      @unique @default(cuid())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([appointmentId, reminderType])
  @@index([barbershopId, status, scheduledFor])
  @@index([scheduledFor])
}

// ----------------------------------------------------
// Financial Management (Gestão Financeira, Caixa, Contas, Transações)
// ----------------------------------------------------

model FinancialAccount {
  id             String                 @id @default(cuid())
  barbershopId   String
  barbershop     Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name           String                 // e.g. "Caixa Balcão", "Banco Inter", "Conta Cora"
  type           String                 @default("CASH") // CASH, BANK, DIGITAL
  initialBalance Float                  @default(0.0)
  currentBalance Float                  @default(0.0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  transactions         FinancialTransaction[] @relation("AccountTransactions")
  transfersTo          FinancialTransaction[] @relation("TransferToAccountTransactions")
  cashRegisters        CashRegister[]
  recurringRules       FinancialRecurringRule[]

  @@index([barbershopId])
  @@index([isActive])
}

model FinancialCategory {
  id           String                 @id @default(cuid())
  barbershopId String
  barbershop   Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String                 // e.g. "Serviços", "Aluguel", "Produtos", "Marketing", "Salários", "Comissões"
  type         String                 @default("EXPENSE") // INCOME, EXPENSE
  color        String?                @default("#f59e0b")
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  transactions   FinancialTransaction[]
  recurringRules FinancialRecurringRule[]

  @@index([barbershopId])
  @@index([type])
  @@index([isActive])
}

model Supplier {
  id           String                 @id @default(cuid())
  barbershopId String
  barbershop   Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String
  document     String?                // CPF / CNPJ
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  transactions   FinancialTransaction[]
  recurringRules FinancialRecurringRule[]

  @@index([barbershopId])
  @@index([isActive])
}

model FinancialTransaction {
  id                String             @id @default(cuid())
  barbershopId      String
  barbershop        Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  
  description       String
  type              String             // INCOME, EXPENSE, TRANSFER
  amount            Float
  feeAmount         Float              @default(0.0) // Gateway / Card fees
  netAmount         Float              // amount - feeAmount
  
  categoryId        String?
  category          FinancialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  accountId         String?
  account           FinancialAccount?  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: SetNull)
  
  toAccountId       String?            // Used only when type === 'TRANSFER'
  toAccount         FinancialAccount?  @relation("TransferToAccountTransactions", fields: [toAccountId], references: [id], onDelete: SetNull)
  
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  appointmentId     String?
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  paymentId         String?            @unique // IDEMPOTENCY KEY linked to Payment
  
  status            String             @default("CONFIRMADO") // PENDENTE, CONFIRMADO, PAGO, RECEBIDO, CANCELADO, ESTORNADO
  dueDate           DateTime?
  paidDate          DateTime?
  paymentMethod     String?            // PIX, DINHEIRO, CARTAO_CREDITO, CARTAO_DEBITO, TRANSFERENCIA, BOLETO, OUTRO
  
  isRecurring       Boolean            @default(false)
  recurringRuleId   String?
  recurringRule     FinancialRecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  
  cashRegisterId    String?
  cashRegister      CashRegister?      @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  
  createdBy         String?
  paidBy            String?
  cancelledBy       String?
  cancelledAt       DateTime?
  reversalReason    String?
  notes             String?
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([barbershopId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([paidDate])
  @@index([categoryId])
  @@index([accountId])
  @@index([paymentId])
  @@index([barbershopId, type, status])
  @@index([barbershopId, paidDate])
}

model CashRegister {
  id              String                 @id @default(cuid())
  barbershopId    String
  barbershop      Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  accountId       String
  account         FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  openedAt        DateTime               @default(now())
  closedAt        DateTime?
  openedBy        String?
  closedBy        String?
  
  initialBalance  Float                  @default(0.0)
  expectedBalance Float                  @default(0.0) // initialBalance + sum(incomes) - sum(expenses)
  actualBalance   Float?                 // counted by user
  difference      Float?                 // actualBalance - expectedBalance
  
  status          String                 @default("OPEN") // OPEN, CLOSED
  notes           String?
  
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  transactions    FinancialTransaction[]

  @@index([barbershopId])
  @@index([status])
  @@index([openedAt])
}

model FinancialRecurringRule {
  id               String                 @id @default(cuid())
  barbershopId     String
  barbershop       Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  description      String
  type             String                 @default("EXPENSE") // EXPENSE, INCOME
  amount           Float
  
  categoryId       String?
  category         FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId        String?
  account          FinancialAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  supplierId       String?
  supplier         Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  frequency        String                 @default("MONTHLY") // WEEKLY, BIWEEKLY, MONTHLY, YEARLY
  startDate        DateTime
  endDate          DateTime?
  occurrencesLimit Int?
  isActive         Boolean                @default(true)
  
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  transactions     FinancialTransaction[]

  @@index([barbershopId])
  @@index([isActive])
}

model MoneyOnTheTableRecovery {
  id                    String      @id @default(cuid())
  barbershopId          String
  barbershop            Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  opportunityDetectedAt DateTime    @default(now())
  opportunityAmount     Float       @default(0.0)
  priority              String      @default("MEDIA") // ALTA, MEDIA, BAIXA
  
  appointmentId         String?     @unique
  appointment           Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recoveredAmount       Float       @default(0.0)
  recoveredAt           DateTime?
  status                String      @default("PENDING") // PENDING, RECOVERED, EXPIRED
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([barbershopId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
}

// ----------------------------------------------------
// Academia BarberFlow (Educação, Conteúdos, Progresso, IA)
// ----------------------------------------------------

model EducationProgress {
  id           String     @id @default(cuid())
  userId       String
  barbershopId String
  contentId    String
  isCompleted  Boolean    @default(true)
  completedAt  DateTime   @default(now())

  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([barbershopId])
  @@index([userId])
}

model EducationFavorite {
  id           String     @id @default(cuid())
  userId       String
  barbershopId String
  contentId    String
  createdAt    DateTime   @default(now())

  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([barbershopId])
  @@index([userId])
}

model EducationAiConsultation {
  id                  String     @id @default(cuid())
  userId              String
  barbershopId        String
  question            String
  topic               String?
  diagnosis           String?
  recommendation      String?
  actionPlanJson      String?
  metric              String?
  disclaimer          String?
  responseTimeMs      Int?
  modelUsed           String     @default("DETERMINISTIC_RULES_ENGINE")
  createdAt           DateTime   @default(now())

  barbershop          Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([userId])
}

model AcademyDiagnostic {
  id                 String      @id @default(cuid())
  barbershopId       String
  userId             String
  answersJson        String      // Respostas das 15 perguntas
  realMetricsJson    String?     // Snapshot das métricas reais apuradas
  healthScore        Int         // 0 a 100
  healthCategory     String      // EXCELENTE, SAUDAVEL, ATENCAO, CRITICO, DADOS_INSUFICIENTES
  prioritiesJson     String      // Até 3 prioridades diárias ("O que fazer hoje")
  biggestProblem     String?     // Maior problema apontado
  missingDataJson    String?     // Explicação quando faltam dados
  status             String      @default("COMPLETED")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  barbershop         Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionPlans        AcademyActionPlan[]

  @@index([barbershopId])
  @@index([userId])
  @@index([healthCategory])
}

model AcademyActionPlan {
  id                     String             @id @default(cuid())
  barbershopId           String
  userId                 String
  diagnosticId           String?
  title                  String
  problem                String
  whyItMatters           String
  action                 String
  howTo                  String
  deadlineDays           Int                @default(7)
  targetDeadline         DateTime?
  indicator              String
  recommendedCategory    String?
  recommendedContentIds  String?            // IDs JSON de conteúdos da Academia
  recommendedToolId      String?
  recommendedChecklistId String?
  status                 String             @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, CONCLUIDO
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  barbershop             Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnostic             AcademyDiagnostic? @relation(fields: [diagnosticId], references: [id], onDelete: SetNull)

  @@index([barbershopId])
  @@index([userId])
  @@index([status])
  @@index([diagnosticId])
}

model AcademyDiagnosticSnapshot {
  id           String     @id @default(cuid())
  barbershopId String
  score        Int
  category     String
  metricsJson  String
  createdAt    DateTime   @default(now())

  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([createdAt])
}

// ----------------------------------------------------
// Visagismo BarberFlow — Mude seu visual (Zero Custo IA / LGPD)
// ----------------------------------------------------

model VisagismSession {
  id              String                  @id @default(cuid())
  barbershopId    String
  customerId      String?
  publicToken     String                  @unique @default(cuid())
  status          String                  @default("DRAFT") // DRAFT, PHOTO_UPLOADED, PROFILE_COMPLETED, COMPLETED, EXPIRED, DELETED
  consentAt       DateTime?
  photoStorageKey String?
  photoMimeType   String?
  photoSize       Int?
  photoDeletedAt  DateTime?
  expiresAt       DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  barbershop      Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  profile         VisagismProfile?
  recommendations VisagismRecommendation[]
  metrics         VisagismMetric[]

  @@index([barbershopId])
  @@index([publicToken])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model VisagismProfile {
  id               String          @id @default(cuid())
  sessionId        String          @unique
  objective        String          // Corte, Barba, Corte + Barba, Cor, Estilo completo, Nao sei
  style            String          // Classico, Moderno, Executivo, Casual, Despojado, Degrade, Longo, Curto, Marcante, Natural
  changeLevel      String          // Pouco, Medio, Radical
  maintenanceLevel String          // Pouco, Medio, Bastante
  hairLength       String          // Sim, Nao, Tanto faz
  faceShape        String          // Oval, Redondo, Quadrado, Retangular, Triangular, Coracao, Nao sei
  colorPreference  String?         // Natural, Castanho, Castanho escuro, Castanho claro, Loiro, Platinado, Grisalho, Colorido
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  session          VisagismSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model VisagismRecommendation {
  id                  String          @id @default(cuid())
  sessionId           String
  haircutName         String
  haircutStyle        String
  beardName           String?
  hairColor           String?
  maintenance         String
  reasoning           String
  barberTips          String?
  serviceSuggestionId String?
  referenceImageUrl   String?
  score               Float           @default(80.0)
  isSelected          Boolean         @default(false)
  createdAt           DateTime        @default(now())

  session             VisagismSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([isSelected])
}

model VisagismMetric {
  id           String           @id @default(cuid())
  barbershopId String
  sessionId    String?
  eventName    String           // visagism_started, photo_uploaded, consent_given, profile_completed, recommendation_generated, style_saved, appointment_clicked, appointment_created, whatsapp_shared
  metadata     String?          // JSON payload
  createdAt    DateTime         @default(now())

  barbershop   Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  session      VisagismSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([barbershopId])
  @@index([sessionId])
  @@index([eventName])
  @@index([createdAt])
}

// ----------------------------------------------------
// SaaS Administration & Platform Control (Fase 20)
// ----------------------------------------------------

model AdminAuditLog {
  id           String      @id @default(cuid())
  adminUserId  String
  adminUser    User        @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action       String      // LOGIN, LOGOUT, SUSPEND_TENANT, REACTIVATE_TENANT, CHANGE_PLAN, UPDATE_USER, CREATE_PLAN, UPDATE_PLAN, RECORD_PAYMENT, IMPERSONATE, CONFIG_UPDATE
  entity       String      // Barbershop, User, Plan, Subscription, SaaSPayment, SaaSSetting
  entityId     String?
  tenantId     String?
  tenant       Barbershop? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  metadata     String?     // JSON metadata (never containing passwords, tokens or secrets)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([adminUserId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

model SaaSPayment {
  id              String        @id @default(cuid())
  barbershopId    String
  barbershop      Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount          Float
  status          String        @default("PAID") // PAID, PENDING, FAILED, REFUNDED, CANCELLED
  method          String        @default("PIX") // PIX, CREDIT_CARD, BOLETO, BANK_TRANSFER, MANUAL
  paidAt          DateTime?
  dueDate         DateTime?
  periodStart     DateTime?
  periodEnd       DateTime?
  reference       String?       // Invoice / Receipt ID
  notes           String?
  metadata        String?       // JSON metadata
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([barbershopId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
}

model SaaSSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // GENERAL, OPERATIONAL, SECURITY, NOTIFICATIONS, INTEGRATIONS
  description String?
  isEncrypted Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
}



