# ----------------------------------------------------
# BarberFlow SaaS — Environment Variables Template
# ----------------------------------------------------

# Database Connection
# SQLite for local dev: file:./dev.db
# PostgreSQL for production: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Authentication & Security (generate 32+ character secrets in production)
NEXTAUTH_SECRET="generate-secure-random-32-chars-secret"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="generate-secure-random-32-chars-secret"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# WhatsApp Provider Configuration (WAHA Native)
WAHA_URL="http://localhost:3001"
WAHA_API_KEY=""
WAHA_DEFAULT_SESSION="default"
WHATSAPP_PROVIDER="WAHA"
WHATSAPP_VERIFY_TOKEN="barberflow_webhook_verify_secret"

# AI Integrations (Vision & Visagism)
GEMINI_API_KEY=""
REPLICATE_API_TOKEN=""

# Webhooks & Integrations
PAYMENT_WEBHOOK_SECRET=""
WEBHOOK_DEFAULT_HMAC_SECRET=""
