# ----------------------------------------------------
# BarberFlow SaaS Environment Variables Template
# ----------------------------------------------------

# Database Connection (PostgreSQL for production, SQLite for local dev)
# Example PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Example SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret (MUST be at least 32 characters in production)
# Generate via: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"

# Public URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Webhooks & Integrations
PAYMENT_WEBHOOK_SECRET="replace_with_payment_webhook_secret"
N8N_DEFAULT_HMAC_SECRET="replace_with_n8n_hmac_secret"
